---
/* Pure CSS + SVG ambient P3R × P5R graphic backdrop (zero JS overhead) */
---

<div class="p3-backdrop" aria-hidden="true">
  <div class="p3-backdrop__caustic p3-backdrop__caustic--1"></div>
  <div class="p3-backdrop__caustic p3-backdrop__caustic--2"></div>
  <div class="p3-backdrop__halftone"></div>
  <div class="p3-backdrop__slash-line"></div>
  <div class="p3-backdrop__bubbles">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>
</div>

<style>
  .p3-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .p3-backdrop__caustic {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    will-change: transform;
  }

  .p3-backdrop__caustic--1 {
    top: -18%;
    right: -8%;
    width: 56vw;
    height: 56vw;
    max-width: 760px;
    max-height: 760px;
    background: radial-gradient(circle, rgba(14, 124, 255, 0.28) 0%, rgba(60, 226, 255, 0.08) 48%, transparent 72%);
    animation: causticDriftA 16s ease-in-out infinite alternate;
  }

  .p3-backdrop__caustic--2 {
    bottom: -22%;
    left: -12%;
    width: 50vw;
    height: 50vw;
    max-width: 680px;
    max-height: 680px;
    background: radial-gradient(circle, rgba(16, 43, 87, 0.52) 0%, rgba(14, 124, 255, 0.14) 52%, transparent 74%);
    animation: causticDriftB 19s ease-in-out infinite alternate;
  }

  .p3-backdrop__halftone {
    position: absolute;
    top: 0;
    right: 0;
    width: min(46vw, 620px);
    height: 440px;
    background-image: radial-gradient(rgba(60, 226, 255, 0.16) 1.35px, transparent 1.35px);
    background-size: 12px 12px;
    clip-path: polygon(38% 0, 100% 0, 100% 82%, 76% 45%);
    opacity: 0.7;
  }

  .p3-backdrop__slash-line {
    position: absolute;
    top: -10vh;
    right: 26vw;
    width: 1px;
    height: 130vh;
    background: linear-gradient(180deg, transparent 0%, rgba(60, 226, 255, 0.16) 35%, rgba(255, 46, 84, 0.18) 72%, transparent 100%);
    transform: rotate(16deg);
  }

  .p3-backdrop__bubbles span {
    position: absolute;
    bottom: -32px;
    border-radius: 999px;
    border: 1px solid rgba(60, 226, 255, 0.24);
    background: radial-gradient(circle at 30% 30%, rgba(245, 250, 255, 0.25), transparent 70%);
    animation: ambientRise 15s linear infinite;
  }

  .p3-backdrop__bubbles span:nth-child(1) { left: 8%; width: 9px; height: 9px; animation-duration: 14s; animation-delay: 0s; }
  .p3-backdrop__bubbles span:nth-child(2) { left: 24%; width: 15px; height: 15px; animation-duration: 18s; animation-delay: 3s; }
  .p3-backdrop__bubbles span:nth-child(3) { left: 46%; width: 7px; height: 7px; animation-duration: 13s; animation-delay: 6s; }
  .p3-backdrop__bubbles span:nth-child(4) { left: 67%; width: 18px; height: 18px; animation-duration: 20s; animation-delay: 1.5s; }
  .p3-backdrop__bubbles span:nth-child(5) { left: 83%; width: 11px; height: 11px; animation-duration: 16s; animation-delay: 4.5s; }
  .p3-backdrop__bubbles span:nth-child(6) { left: 93%; width: 8px; height: 8px; animation-duration: 15s; animation-delay: 8s; }

  @keyframes causticDriftA {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    100% { transform: translate3d(-4%, 5%, 0) scale(1.08); }
  }

  @keyframes causticDriftB {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    100% { transform: translate3d(5%, -4%, 0) scale(1.06); }
  }

  @keyframes ambientRise {
    0% { transform: translate3d(0, 0, 0) scale(0.85); opacity: 0; }
    15% { opacity: 0.45; }
    80% { opacity: 0.25; }
    100% { transform: translate3d(18px, -108vh, 0) scale(1.12); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .p3-backdrop__caustic,
    .p3-backdrop__bubbles span {
      animation: none;
    }
    .p3-backdrop__bubbles {
      display: none;
    }
  }
</style>
