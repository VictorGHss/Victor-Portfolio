---
import { localizePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = UI[locale];
const statusLabel = t.projects.statusLabels[project.status];
const detailHref = localizePath(locale, `projects/${project.slug}`);
---

<article class={`proj-row ${project.priority === 1 ? 'proj-row--flagship' : ''}`}>
  <div class="proj-row__index">0{project.priority}</div>

  <div class="proj-row__body">
    <div class="proj-row__meta">
      <span class={`status-label ${project.status === 'used-in-production' ? 'status-label--cyan' : ''}`}>
        {statusLabel}
      </span>
      {project.priority === 1 && (
        <span class="status-label status-label--accent">{t.projects.flagshipBadge}</span>
      )}
      {project.secondary && (
        <span class="proj-row__secondary">{t.projects.secondaryBadge}</span>
      )}
    </div>

    <h2 class="proj-row__title display-title">
      <a href={detailHref}>{project.name[locale]}</a>
    </h2>

    <p class="proj-row__tagline">{project.tagline[locale]}</p>
    <p class="proj-row__context">{project.timelineContext[locale]}</p>
    <p class="proj-row__stack">{project.stack.join(' · ')}</p>
  </div>

  <div class="proj-row__actions">
    <a href={detailHref} class="p3-btn p3-btn--primary">
      {t.home.viewCaseStudy}
    </a>
    {project.repoUrl && (
      <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="p3-link">
        GitHub ↗
      </a>
    )}
  </div>
</article>

<style>
  .proj-row {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-5);
    background: var(--surface-elevated);
    border-left: 3px solid transparent;
    transition:
      border-color var(--duration-base) var(--ease-snappy),
      background-color var(--duration-base) var(--ease-snappy),
      transform var(--duration-base) var(--ease-snappy);
  }

  .proj-row:hover {
    border-left-color: var(--color-cyan);
    background: #0e2442;
    transform: translateX(4px);
  }

  .proj-row--flagship {
    border-left-color: var(--color-electric-blue);
    background: linear-gradient(115deg, rgba(18, 59, 112, 0.52), rgba(11, 30, 56, 0.95));
  }

  .proj-row__index {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-cyan);
    opacity: 0.72;
    padding-top: 0.2rem;
  }

  .proj-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .proj-row__secondary {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .proj-row__title {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    margin-bottom: 0.45rem;
  }

  .proj-row__title a:hover {
    color: var(--color-cyan);
  }

  .proj-row__tagline {
    margin: 0 0 0.5rem;
    color: var(--text-secondary);
    max-width: 68ch;
  }

  .proj-row__context {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-cyan);
  }

  .proj-row__stack {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .proj-row__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.65rem;
  }

  @media (max-width: 820px) {
    .proj-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-4);
    }

    .proj-row__actions {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
    }
  }
</style>
