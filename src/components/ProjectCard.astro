---
import { localizePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = UI[locale];
const statusLabel = t.projects.statusLabels[project.status];
const detailHref = localizePath(locale, `projects/${project.slug}`);
---

<article class={`proj-row ${project.priority === 1 ? 'proj-row--flagship' : ''}`} data-reveal>
  <div class="proj-row__index">0{project.priority}</div>

  <div class="proj-row__body">
    <div class="proj-row__meta">
      <span class={`status-label ${project.status === 'concluded-operation' || project.status === 'collaborative' ? 'status-label--cyan' : ''}`}>
        {statusLabel}
      </span>
      {project.priority === 1 && (
        <span class="status-label status-label--accent">{t.projects.flagshipBadge}</span>
      )}
    </div>

    <h2 class="proj-row__title display-title">
      <a href={detailHref}>{project.name[locale]}</a>
    </h2>

    <p class="proj-row__tagline">{project.tagline[locale]}</p>
    <p class="proj-row__context">{project.timelineContext[locale]}</p>
    <p class="proj-row__stack">{project.stack.join(' · ')}</p>
  </div>

  <div class="proj-row__actions">
    <a href={detailHref} class="p3-btn p3-btn--primary">
      <span>{t.home.viewCaseStudy}</span>
    </a>
    {project.liveUrl && (
      <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="p3-link">
        {project.liveLabel ? project.liveLabel[locale] : 'Live'} ↗
      </a>
    )}
    {project.repoUrl && (
      <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="p3-link">
        {project.repoLabel ? project.repoLabel[locale] : 'GitHub'} ↗
      </a>
    )}
  </div>
</article>

<style>
  .proj-row {
    display: grid;
    grid-template-columns: 68px 1fr auto;
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-5);
    background: var(--surface-elevated);
    border: 1px solid rgba(60, 226, 255, 0.22);
    border-left: 5px solid var(--color-electric-blue);
    box-shadow: 6px 6px 0px rgba(4, 11, 22, 0.95);
    transition:
      border-color var(--duration-fast) var(--ease-snappy),
      background-color var(--duration-fast) var(--ease-snappy),
      transform var(--duration-fast) var(--ease-pop),
      box-shadow var(--duration-fast) var(--ease-pop);
  }

  .proj-row:hover {
    border-left-color: var(--color-accent);
    border-color: var(--color-cyan);
    background: #0d2142;
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0px var(--color-electric-blue);
  }

  .proj-row--flagship {
    border-left-color: var(--color-accent);
    border-color: var(--color-cyan);
    background: linear-gradient(120deg, #0d2449 0%, #08162e 100%);
    box-shadow: 8px 8px 0px var(--color-electric-blue);
  }

  .proj-row__index {
    font-family: var(--font-display);
    font-size: 2.65rem;
    line-height: 0.92;
    color: var(--color-cyan);
    transform: skewX(-8deg);
  }

  .proj-row--flagship .proj-row__index {
    color: var(--color-pure-white);
    text-shadow: 3px 3px 0 var(--color-accent);
  }

  .proj-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .proj-row__title {
    font-size: clamp(1.75rem, 3.2vw, 2.45rem);
    margin-bottom: 0.45rem;
  }

  .proj-row__title a:hover {
    color: var(--color-cyan);
  }

  .proj-row__tagline {
    margin: 0 0 0.5rem;
    color: var(--text-secondary);
    max-width: 66ch;
    font-size: 1rem;
  }

  .proj-row__context {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-cyan);
  }

  .proj-row__stack {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .proj-row__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  @media (max-width: 860px) {
    .proj-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-4);
    }

    .proj-row__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
    }
  }
</style>
