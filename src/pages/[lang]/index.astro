---
import { LOCALES, type Locale } from '../../i18n/config';
import { UI } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeView from '../../views/HomeView.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = UI[locale];
const title =
  locale === 'pt-br'
    ? 'Vito.dev | Victor Gabriel — Engenharia de Software, Backend & Automações'
    : 'Vito.dev | Victor Gabriel — Software Engineering, Backend & Automation';
const description = t.home.summary;
---

<BaseLayout locale={locale} title={title} description={description}>
  <HomeView locale={locale} />
</BaseLayout>
