---
import { COURSES, EDUCATION, LANGUAGES } from '../data/portfolio';
import { localizePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
---

<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">05 // {t.nav[4].label}</span>
        <h1 class="display-title section-title">{t.about.pageTitle}</h1>
        <p class="section-subtitle">{t.about.pageSubtitle}</p>
      </div>
    </div>

    <div class="about-layout">
      <div class="about-essay">
        <h2 class="display-title about-heading">{t.about.bioTitle}</h2>
        <p class="about-lead">{t.about.bioText}</p>

        <h2 class="display-title about-heading">{t.about.educationTitle}</h2>
        <div class="about-list">
          {EDUCATION.map((edu) => (
            <div class="about-row">
              <span class="about-row__meta">{edu.period[locale]}</span>
              <div>
                <strong>{edu.degree[locale]}</strong>
                <span class="about-row__sub">{edu.institution[locale]}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <aside class="about-aside surface-block">
        <div>
          <h2 class="display-title about-aside__title">{t.about.coursesTitle}</h2>
          <ul class="about-courses">
            {COURSES.map((course) => (
              <li>
                <strong>{course.name[locale]}</strong>
                <span>{course.provider}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="display-title about-aside__title">{t.about.languagesTitle}</h2>
          <ul class="about-langs">
            {LANGUAGES.map((lang) => (
              <li>
                <strong>{lang.name[locale]}:</strong> {lang.level[locale]}
              </li>
            ))}
          </ul>
        </div>

        <a href={localizePath(locale, 'projects')} class="p3-btn p3-btn--primary">
          {t.home.allProjectsCta}
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-layout {
    display: grid;
    grid-template-columns: 1.3fr 0.85fr;
    gap: var(--space-6);
    align-items: start;
  }

  .about-heading {
    font-size: 1.55rem;
    color: var(--color-cyan);
    margin: 0 0 var(--space-3);
  }

  .about-lead {
    margin: 0 0 var(--space-6);
    color: var(--text-secondary);
    font-size: 1.04rem;
  }

  .about-list {
    border-top: 1px solid rgba(232, 242, 255, 0.09);
  }

  .about-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid rgba(232, 242, 255, 0.08);
  }

  .about-row__meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-cyan);
  }

  .about-row__sub {
    display: block;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .about-aside {
    padding: var(--space-5);
    display: grid;
    gap: var(--space-5);
    border-left: 3px solid var(--color-electric-blue);
  }

  .about-aside__title {
    font-size: 1.25rem;
    color: var(--color-cyan);
    margin-bottom: var(--space-3);
  }

  .about-courses,
  .about-langs {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.65rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .about-courses span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .about-layout,
    .about-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
