---
import CopyEmailButton from '../components/CopyEmailButton';
import { PROFILE } from '../data/profile';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const resumePath = PROFILE.resumeFiles[locale];
---

<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker display-kicker--accent">07 // {t.nav[6].label}</span>
        <h1 class="display-title section-title">{t.contact.pageTitle}</h1>
        <p class="section-subtitle">{t.contact.pageSubtitle}</p>
      </div>
    </div>

    <div class="contact-grid">
      <article class="contact-card p3-panel p3-panel--chamfer">
        <h2 class="display-title contact-card__title">{t.contact.directChannels}</h2>

        <div class="contact-item">
          <span class="contact-item__label">{t.contact.emailLabel}</span>
          <a href={`mailto:${PROFILE.email}`} class="contact-item__value">{PROFILE.email}</a>
          <div class="contact-item__actions">
            <CopyEmailButton
              client:load
              email={PROFILE.email}
              copyLabel={t.contact.copyEmail}
              copiedLabel={t.contact.copiedEmail}
            />
          </div>
        </div>

        <div class="contact-links">
          <a href={PROFILE.githubUrl} target="_blank" rel="noopener noreferrer" class="p3-btn p3-btn--primary">
            {t.contact.githubLabel} — @{PROFILE.githubUsername}
          </a>
          <a href={PROFILE.linkedinUrl} target="_blank" rel="noopener noreferrer" class="p3-btn p3-btn--secondary">
            {t.contact.linkedinLabel}
          </a>
        </div>
      </article>

      <div class="contact-side">
        <article class="contact-card p3-panel">
          <h2 class="display-title contact-card__title">{t.contact.resumeTitle}</h2>
          {resumePath ? (
            <a href={resumePath} download class="p3-btn p3-btn--primary">
              {t.home.resumeCta} (PDF)
            </a>
          ) : (
            <p class="contact-card__text">{t.contact.resumePending}</p>
          )}
        </article>

        <article class="contact-card p3-panel">
          <h2 class="display-title contact-card__title">{t.contact.availabilityTitle}</h2>
          <p class="contact-card__text">{t.contact.availabilityText}</p>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-5);
  }

  .contact-side {
    display: grid;
    gap: var(--space-4);
  }

  .contact-card {
    padding: var(--space-5);
  }

  .contact-card__title {
    font-size: 1.6rem;
    color: var(--color-cyan);
    margin-bottom: var(--space-4);
  }

  .contact-card__text {
    margin: 0;
    color: var(--text-secondary);
  }

  .contact-item {
    padding: var(--space-4);
    background: rgba(7, 20, 38, 0.72);
    border-left: 3px solid var(--color-electric-blue);
    margin-bottom: var(--space-4);
  }

  .contact-item__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .contact-item__value {
    display: inline-block;
    margin: 0.25rem 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-ice-white);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
