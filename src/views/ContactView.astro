---
import CopyEmailButton from '../components/CopyEmailButton';
import { PROFILE } from '../data/profile';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const primaryResume = PROFILE.resumeFiles[locale];
const altResume = locale === 'pt-br' ? PROFILE.resumeFiles.en : PROFILE.resumeFiles['pt-br'];
const altResumeLabel = locale === 'pt-br' ? 'English Version (PDF)' : 'Versão em Português (PDF)';
---

<section class="section">
  <div class="section-watermark" aria-hidden="true">CONTACT</div>
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker display-kicker--accent">07 // {t.nav[6].label}</span>
        <h1 class="display-title section-title">{t.contact.pageTitle}</h1>
        <p class="section-subtitle">{t.contact.pageSubtitle}</p>
      </div>
    </div>

    <div class="contact-grid">
      <article class="contact-card surface-block" data-reveal>
        <h2 class="display-title contact-card__title">{t.contact.directChannels}</h2>

        <div class="contact-item paper-slab">
          <span class="contact-item__label">{t.contact.emailLabel}</span>
          <a href={`mailto:${PROFILE.email}`} class="contact-item__value">{PROFILE.email}</a>
          <div class="contact-item__actions">
            <CopyEmailButton
              client:load
              email={PROFILE.email}
              copyLabel={t.contact.copyEmail}
              copiedLabel={t.contact.copiedEmail}
            />
          </div>
        </div>

        <div class="contact-links">
          <a href={PROFILE.githubUrl} target="_blank" rel="noopener noreferrer" class="p3-btn p3-btn--primary">
            <span>{t.contact.githubLabel} — @{PROFILE.githubUsername} ↗</span>
          </a>
          <a href={PROFILE.linkedinUrl} target="_blank" rel="noopener noreferrer" class="p3-btn p3-btn--secondary">
            <span>{t.contact.linkedinLabel} ↗</span>
          </a>
        </div>
      </article>

      <div class="contact-side">
        <article class="contact-card surface-block" data-reveal>
          <h2 class="display-title contact-card__title">{t.contact.resumeTitle}</h2>
          <div class="resume-actions">
            <a href={primaryResume} download class="p3-btn p3-btn--primary">
              <span>{t.contact.resumeDownload}</span>
            </a>
            <a href={altResume} download class="p3-link">
              {altResumeLabel} ↓
            </a>
          </div>
          <p class="contact-card__note">{t.contact.resumeAltNote}</p>
        </article>

        <article class="contact-card surface-block" data-reveal>
          <h2 class="display-title contact-card__title">{t.contact.availabilityTitle}</h2>
          <p class="contact-card__text">{t.contact.availabilityText}</p>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: var(--space-5);
  }

  .contact-side {
    display: grid;
    gap: var(--space-4);
  }

  .contact-card {
    padding: var(--space-5);
    border-left: 5px solid var(--color-electric-blue);
  }

  .contact-card__title {
    font-size: 1.8rem;
    color: var(--color-cyan);
    margin-bottom: var(--space-4);
  }

  .contact-card__text {
    margin: 0;
    color: var(--text-secondary);
  }

  .contact-card__note {
    margin: var(--space-3) 0 0;
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .contact-item {
    padding: var(--space-4);
    border-left: 5px solid var(--color-accent);
    margin-bottom: var(--space-5);
  }

  .contact-item__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .contact-item__value {
    display: inline-block;
    margin: 0.25rem 0 0.85rem;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-inverse);
  }

  .contact-links,
  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
