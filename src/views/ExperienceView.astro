---
import { EDUCATION, EXPERIENCE } from '../data/portfolio';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
---

<section class="section">
  <div class="section-watermark" aria-hidden="true">CAREER</div>
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">03 // {t.nav[2].label}</span>
        <h1 class="display-title section-title">{t.experience.pageTitle}</h1>
        <p class="section-subtitle">{t.experience.pageSubtitle}</p>
      </div>
    </div>

    <div class="timeline">
      {EXPERIENCE.map((item, idx) => (
        <article class="timeline-item" data-reveal>
          <div class="timeline-item__aside">
            <span class="timeline-item__num">0{idx + 1}</span>
            <span class="timeline-item__period">{item.period[locale]}</span>
            <span class="timeline-item__company">{item.company[locale]}</span>
          </div>

          <div class={`timeline-item__body surface-block ${idx === 0 ? 'timeline-item__body--lead' : ''}`}>
            <h2 class="display-title timeline-item__role">{item.role[locale]}</h2>
            <p class="timeline-item__summary">{item.summary[locale]}</p>

            {item.progressionNote && (
              <p class="timeline-item__progression">{item.progressionNote[locale]}</p>
            )}

            <h3 class="timeline-item__sub">{t.experience.highlightsLabel}</h3>
            <ul class="timeline-item__list">
              {item.highlights[locale].map((point) => (
                <li>{point}</li>
              ))}
            </ul>

            <p class="timeline-item__tags">{item.tags.join(' · ')}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="edu-block" data-reveal>
      <h2 class="display-title section-title">{t.experience.educationTitle}</h2>
      <div class="edu-list">
        {EDUCATION.map((edu) => (
          <div class="edu-row">
            <span class="edu-row__period">{edu.period[locale]}</span>
            <div>
              <strong class="edu-row__degree">{edu.degree[locale]}</strong>
              <span class="edu-row__inst">{edu.institution[locale]}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .timeline-item__aside {
    display: grid;
    gap: 0.3rem;
  }

  .timeline-item__num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 0.9;
    color: var(--color-accent);
    transform: skewX(-8deg);
  }

  .timeline-item__period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-cyan);
  }

  .timeline-item__company {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-primary);
  }

  .timeline-item__body {
    padding: var(--space-5);
    border-left: 5px solid var(--color-electric-blue);
  }

  .timeline-item__body--lead {
    border-left-color: var(--color-accent);
    box-shadow: 8px 8px 0px var(--color-electric-blue);
  }

  .timeline-item__role {
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    margin-bottom: 0.55rem;
  }

  .timeline-item__summary {
    margin: 0 0 var(--space-4);
    color: var(--text-secondary);
  }

  .timeline-item__progression {
    margin: 0 0 var(--space-4);
    padding: 0.75rem 1rem;
    background: var(--surface-paper);
    color: var(--text-inverse);
    font-weight: 700;
    border-left: 4px solid var(--color-accent);
    font-size: 0.9rem;
  }

  .timeline-item__sub {
    margin: 0 0 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-cyan);
  }

  .timeline-item__list {
    margin: 0 0 var(--space-4);
    padding-left: 1.2rem;
    color: var(--text-secondary);
    display: grid;
    gap: 0.45rem;
  }

  .timeline-item__tags {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-cyan);
  }

  .edu-list {
    margin-top: var(--space-5);
    border-top: 2px solid rgba(60, 226, 255, 0.2);
  }

  .edu-row {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-bottom: 1px solid rgba(60, 226, 255, 0.14);
  }

  .edu-row__period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-cyan);
  }

  .edu-row__degree {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.08rem;
    color: var(--color-pure-white);
  }

  .edu-row__inst {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  @media (max-width: 820px) {
    .timeline-item,
    .edu-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .timeline-item__body {
      padding: var(--space-4);
    }
  }
</style>
