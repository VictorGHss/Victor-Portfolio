---
import { EXPERIENCE } from '../data/portfolio';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
---

<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">03 // {t.nav[2].label}</span>
        <h1 class="display-title section-title">{t.experience.pageTitle}</h1>
        <p class="section-subtitle">{t.experience.pageSubtitle}</p>
      </div>
    </div>

    <div class="timeline">
      {EXPERIENCE.map((item) => (
        <article class="timeline-item p3-panel p3-panel--chamfer">
          <div class="timeline-item__head">
            <span class="p3-tag p3-tag--cyan">{item.period[locale]}</span>
            <span class="timeline-item__context">{item.context[locale]}</span>
          </div>
          <h2 class="display-title timeline-item__role">{item.role[locale]}</h2>
          <p class="timeline-item__summary">{item.summary[locale]}</p>

          <h3 class="timeline-item__sub">{t.experience.highlightsLabel}</h3>
          <ul class="timeline-item__list">
            {item.highlights[locale].map((point) => (
              <li>{point}</li>
            ))}
          </ul>

          <div class="timeline-item__tags">
            {item.tags.map((tag) => (
              <span class="p3-tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    gap: var(--space-5);
  }

  .timeline-item {
    padding: var(--space-5);
    border-left: 4px solid var(--color-electric-blue);
  }

  .timeline-item__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-3);
  }

  .timeline-item__context {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .timeline-item__role {
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    margin-bottom: 0.5rem;
  }

  .timeline-item__summary {
    margin: 0 0 var(--space-4);
    color: var(--text-secondary);
  }

  .timeline-item__sub {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    color: var(--color-cyan);
  }

  .timeline-item__list {
    margin: 0 0 var(--space-4);
    padding-left: 1.2rem;
    color: var(--text-secondary);
    display: grid;
    gap: 0.35rem;
  }

  .timeline-item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
</style>
