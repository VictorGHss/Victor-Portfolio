---
import { EDUCATION, EXPERIENCE } from '../data/portfolio';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
---

<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">03 // {t.nav[2].label}</span>
        <h1 class="display-title section-title">{t.experience.pageTitle}</h1>
        <p class="section-subtitle">{t.experience.pageSubtitle}</p>
      </div>
    </div>

    <div class="timeline">
      {EXPERIENCE.map((item) => (
        <article class="timeline-item">
          <div class="timeline-item__aside">
            <span class="timeline-item__period">{item.period[locale]}</span>
            <span class="timeline-item__company">{item.company[locale]}</span>
          </div>

          <div class="timeline-item__body surface-block">
            <h2 class="display-title timeline-item__role">{item.role[locale]}</h2>
            <p class="timeline-item__summary">{item.summary[locale]}</p>

            {item.progressionNote && (
              <p class="timeline-item__progression">{item.progressionNote[locale]}</p>
            )}

            <h3 class="timeline-item__sub">{t.experience.highlightsLabel}</h3>
            <ul class="timeline-item__list">
              {item.highlights[locale].map((point) => (
                <li>{point}</li>
              ))}
            </ul>

            <p class="timeline-item__tags">{item.tags.join(' · ')}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="edu-block">
      <h2 class="display-title section-title">{t.experience.educationTitle}</h2>
      <div class="edu-list">
        {EDUCATION.map((edu) => (
          <div class="edu-row">
            <span class="edu-row__period">{edu.period[locale]}</span>
            <div>
              <strong class="edu-row__degree">{edu.degree[locale]}</strong>
              <span class="edu-row__inst">{edu.institution[locale]}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .timeline-item__aside {
    display: grid;
    gap: 0.35rem;
    padding-top: 0.35rem;
  }

  .timeline-item__period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-cyan);
  }

  .timeline-item__company {
    font-weight: 600;
    color: var(--text-primary);
  }

  .timeline-item__body {
    padding: var(--space-5);
    border-left: 3px solid var(--color-electric-blue);
  }

  .timeline-item__role {
    font-size: clamp(1.35rem, 2.3vw, 1.85rem);
    margin-bottom: 0.5rem;
  }

  .timeline-item__summary {
    margin: 0 0 var(--space-3);
    color: var(--text-secondary);
  }

  .timeline-item__progression {
    margin: 0 0 var(--space-4);
    padding: 0.7rem 0.9rem;
    background: rgba(22, 139, 255, 0.12);
    border-left: 2px solid var(--color-cyan);
    font-size: 0.88rem;
    color: var(--color-ice-white);
  }

  .timeline-item__sub {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-transform: uppercase;
    color: var(--color-cyan);
  }

  .timeline-item__list {
    margin: 0 0 var(--space-4);
    padding-left: 1.2rem;
    color: var(--text-secondary);
    display: grid;
    gap: 0.4rem;
  }

  .timeline-item__tags {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .edu-list {
    margin-top: var(--space-4);
    border-top: 1px solid rgba(232, 242, 255, 0.09);
  }

  .edu-row {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-bottom: 1px solid rgba(232, 242, 255, 0.08);
  }

  .edu-row__period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-cyan);
  }

  .edu-row__degree {
    display: block;
    color: var(--color-ice-white);
  }

  .edu-row__inst {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  @media (max-width: 820px) {
    .timeline-item,
    .edu-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .timeline-item__body {
      padding: var(--space-4);
    }
  }
</style>
