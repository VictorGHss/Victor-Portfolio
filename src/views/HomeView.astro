---
import { EXPERIENCE, SKILL_GROUPS } from '../data/portfolio';
import { PROFILE } from '../data/profile';
import { PROJECTS } from '../data/projects';
import { localizePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const flagship = PROJECTS[0];
const selectedProjects = PROJECTS.filter(
  (p) => p.slug !== flagship.slug && p.status !== 'in-development'
);
const inDevProjects = PROJECTS.filter((p) => p.status === 'in-development');
const primarySkills = SKILL_GROUPS.filter((g) => g.tier === 'primary');
const resumeUrl = PROFILE.resumeFiles[locale];
const flagshipRepoLabel = flagship.repoLabel ? flagship.repoLabel[locale] : t.projects.publicShowcaseLabel;
---

<section class="hero section">
  <div class="hero__slash" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__content">
      <span class="display-kicker display-kicker--accent">{t.home.kicker}</span>
      <h1 class="display-title hero__title">
        <span>{t.home.headlineLine1}</span>
        <span>{t.home.headlineLine2}</span>
        <span class="hero__title-accent">{t.home.headlineAccent}</span>
      </h1>
      <p class="hero__summary">{t.home.summary}</p>

      <div class="hero__actions">
        <a href={localizePath(locale, `projects/${flagship.slug}`)} class="p3-btn p3-btn--primary">
          {t.home.primaryCta}
        </a>
        <a href={resumeUrl} download class="p3-btn p3-btn--secondary">
          {t.home.resumeCta}
        </a>
      </div>
    </div>

    <aside class="hero__dossier" aria-label={t.home.specializationLabel}>
      <div class="hero__dossier-top">
        <span class="hero__dossier-brand">{PROFILE.brand}</span>
        <span class="hero__dossier-loc">{PROFILE.location[locale]}</span>
      </div>
      <h2 class="hero__dossier-name display-title">{PROFILE.fullName}</h2>
      <p class="hero__dossier-edu">{PROFILE.education[locale]}</p>

      <div class="hero__spec">
        <span class="hero__spec-label">{t.home.specializationLabel}</span>
        <p class="hero__spec-text">{t.home.specializationText}</p>
      </div>

      <div class="hero__links">
        <a href={PROFILE.githubUrl} target="_blank" rel="noopener noreferrer" class="p3-link">
          GitHub ↗
        </a>
        <a href={PROFILE.linkedinUrl} target="_blank" rel="noopener noreferrer" class="p3-link">
          LinkedIn ↗
        </a>
        <a href={`mailto:${PROFILE.email}`} class="p3-link">
          {PROFILE.email}
        </a>
      </div>
    </aside>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">01 // {t.home.featuredTitle}</span>
        <h2 class="display-title section-title">{flagship.name[locale]}</h2>
        <p class="section-subtitle">{t.home.featuredSubtitle}</p>
      </div>
      <a href={localizePath(locale, 'projects')} class="p3-link">
        {t.home.allProjectsCta} →
      </a>
    </div>

    <div class="flagship">
      <div class="flagship__body">
        <div class="flagship__meta">
          <span class="status-label status-label--accent">{t.projects.flagshipBadge}</span>
          <span class="status-label status-label--cyan">{t.projects.statusLabels[flagship.status]}</span>
        </div>

        <p class="flagship__desc">{flagship.solution[locale]}</p>

        {flagship.metrics && (
          <div class="flagship__metrics">
            {flagship.metrics.slice(0, 3).map((metric) => (
              <div class="metric-item">
                <strong class="metric-item__value">{metric.value}</strong>
                <span class="metric-item__label">{metric.label[locale]}</span>
              </div>
            ))}
          </div>
        )}

        <p class="flagship__stack">{flagship.stack.slice(0, 9).join(' · ')}</p>

        <div class="flagship__actions">
          <a href={localizePath(locale, `projects/${flagship.slug}`)} class="p3-btn p3-btn--primary">
            {t.home.viewCaseStudy}
          </a>
          {flagship.repoUrl && (
            <a href={flagship.repoUrl} target="_blank" rel="noopener noreferrer" class="p3-btn p3-btn--secondary">
              {flagshipRepoLabel} ↗
            </a>
          )}
        </div>
      </div>

      {flagship.screenshots && flagship.screenshots[0] && (
        <figure class="flagship__visual">
          <img
            src={flagship.screenshots[0].src}
            alt={flagship.screenshots[0].alt[locale]}
            loading="lazy"
            width="960"
            height="540"
          />
          <figcaption>{flagship.screenshots[0].caption[locale]}</figcaption>
        </figure>
      )}
    </div>

    <div class="other-projects">
      <h3 class="other-projects__heading">{t.home.otherProjectsTitle}</h3>
      <div class="other-projects__list">
        {selectedProjects.map((project) => (
          <a href={localizePath(locale, `projects/${project.slug}`)} class="project-line">
            <span class="project-line__num">0{project.priority}</span>
            <span class="project-line__title">{project.name[locale]}</span>
            <span class="project-line__desc">{project.tagline[locale]}</span>
            <span class="project-line__stack">{project.stack.slice(0, 4).join(' · ')}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="indev-strip">
      <h3 class="other-projects__heading">{t.home.inDevTitle}</h3>
      <div class="indev-grid">
        {inDevProjects.map((project) => (
          <a href={localizePath(locale, `projects/${project.slug}`)} class="indev-card">
            <div class="indev-card__top">
              <span class="status-label">{t.projects.statusLabels[project.status]}</span>
              <span class="indev-card__num">0{project.priority}</span>
            </div>
            <strong class="indev-card__title">{project.name[locale]}</strong>
            <p class="indev-card__desc">{project.tagline[locale]}</p>
            <span class="indev-card__stack">{project.stack.slice(0, 5).join(' · ')}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section section--compact">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">02 // {t.nav[2].label} &amp; {t.nav[3].label}</span>
        <h2 class="display-title section-title">{t.home.trajectoryTitle}</h2>
        <p class="section-subtitle">{t.home.trajectorySubtitle}</p>
      </div>
      <div class="section-header__links">
        <a href={localizePath(locale, 'experience')} class="p3-link">
          {t.home.trajectoryCta} →
        </a>
        <a href={localizePath(locale, 'skills')} class="p3-link">
          {t.home.skillsCta} →
        </a>
      </div>
    </div>

    <div class="exp-stack-split">
      <div class="trajectory-list">
        {EXPERIENCE.map((item) => (
          <article class="trajectory-item">
            <div class="trajectory-item__period">{item.period[locale]}</div>
            <h3 class="trajectory-item__role">
              {item.role[locale]} <span class="trajectory-item__company">— {item.company[locale]}</span>
            </h3>
            <p class="trajectory-item__summary">{item.summary[locale]}</p>
          </article>
        ))}
      </div>

      <div class="spec-list">
        {primarySkills.map((group) => (
          <div class="spec-row">
            <h3 class="spec-row__cat">{group.category[locale]}</h3>
            <p class="spec-row__items">{group.items.join(' · ')}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section section--compact">
  <div class="container">
    <div class="cta-strip surface-block">
      <div>
        <span class="display-kicker display-kicker--accent">03 // {t.nav[6].label}</span>
        <h2 class="display-title cta-strip__title">{t.home.contactTitle}</h2>
        <p class="cta-strip__subtitle">{t.home.contactSubtitle}</p>
      </div>
      <div class="cta-strip__actions">
        <a href={localizePath(locale, 'contact')} class="p3-btn p3-btn--primary">
          {t.home.contactCta}
        </a>
        <a href={resumeUrl} download class="p3-btn p3-btn--secondary">
          {t.home.resumeCta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }

  .hero__slash {
    position: absolute;
    top: -10%;
    right: -6%;
    width: 46vw;
    height: 118%;
    background: linear-gradient(160deg, rgba(18, 59, 112, 0.35), rgba(7, 20, 38, 0.05));
    clip-path: polygon(32% 0, 100% 0, 68% 100%, 0 100%);
    pointer-events: none;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: var(--space-6);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero__title {
    font-size: clamp(2.35rem, 4.6vw, 3.85rem);
    display: flex;
    flex-direction: column;
    gap: 0.04em;
  }

  .hero__title-accent {
    color: var(--color-cyan);
  }

  .hero__summary {
    margin: var(--space-4) 0 var(--space-5);
    color: var(--text-secondary);
    font-size: 1.06rem;
    max-width: 56ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero__dossier {
    padding: var(--space-4) 0 var(--space-4) var(--space-5);
    border-left: 2px solid rgba(85, 200, 255, 0.35);
    position: relative;
  }

  .hero__dossier-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .hero__dossier-brand {
    color: var(--color-cyan);
    font-weight: 600;
  }

  .hero__dossier-loc {
    color: var(--text-muted);
  }

  .hero__dossier-name {
    font-size: 1.5rem;
  }

  .hero__dossier-edu {
    margin: 0.35rem 0 var(--space-4);
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .hero__spec {
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-electric-blue);
    margin-bottom: var(--space-4);
  }

  .hero__spec-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--color-cyan);
    margin-bottom: 0.25rem;
  }

  .hero__spec-text {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: var(--space-3);
    border-top: 1px solid rgba(232, 242, 255, 0.08);
  }

  .flagship {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-6);
    align-items: start;
    margin-bottom: var(--space-6);
  }

  .flagship__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: var(--space-3);
  }

  .flagship__desc {
    margin: 0 0 var(--space-5);
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .flagship__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid rgba(232, 242, 255, 0.09);
    border-bottom: 1px solid rgba(232, 242, 255, 0.09);
  }

  .metric-item__value {
    display: block;
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--color-cyan);
    line-height: 1.1;
  }

  .metric-item__label {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .flagship__stack {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .flagship__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .flagship__visual {
    margin: 0;
    padding: 0.9rem;
    background: #0b1628;
    border: 1px solid rgba(232, 242, 255, 0.1);
  }

  .flagship__visual img {
    width: 100%;
    height: auto;
  }

  .flagship__visual figcaption {
    padding-top: 0.65rem;
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .other-projects {
    margin-bottom: var(--space-6);
  }

  .other-projects__heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-cyan);
  }

  .other-projects__list {
    display: grid;
    border-top: 1px solid rgba(232, 242, 255, 0.09);
  }

  .project-line {
    display: grid;
    grid-template-columns: 44px 240px 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: 1rem 0.75rem;
    border-bottom: 1px solid rgba(232, 242, 255, 0.08);
    transition: background-color var(--duration-fast), padding-left var(--duration-fast);
  }

  .project-line:hover {
    background: var(--surface-elevated);
    padding-left: 1.15rem;
  }

  .project-line__num {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-cyan);
  }

  .project-line__title {
    font-weight: 700;
    color: var(--color-ice-white);
  }

  .project-line__desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .project-line__stack {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .indev-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .indev-card {
    padding: var(--space-4);
    background: rgba(11, 30, 56, 0.55);
    border-left: 2px dashed rgba(85, 200, 255, 0.35);
    display: grid;
    gap: 0.45rem;
    transition: background-color var(--duration-fast), border-color var(--duration-fast);
  }

  .indev-card:hover {
    background: var(--surface-elevated);
    border-left-color: var(--color-cyan);
  }

  .indev-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .indev-card__num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .indev-card__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-ice-white);
  }

  .indev-card__desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .indev-card__stack {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .section-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .exp-stack-split {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: var(--space-6);
    align-items: start;
  }

  .trajectory-list {
    display: grid;
    gap: var(--space-5);
    border-left: 2px solid rgba(22, 139, 255, 0.45);
    padding-left: var(--space-5);
  }

  .trajectory-item__period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-cyan);
    margin-bottom: 0.25rem;
  }

  .trajectory-item__role {
    margin: 0 0 0.4rem;
    font-size: 1.08rem;
  }

  .trajectory-item__company {
    color: var(--text-muted);
    font-weight: 500;
  }

  .trajectory-item__summary {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .spec-list {
    display: grid;
    gap: var(--space-4);
  }

  .spec-row {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid rgba(232, 242, 255, 0.08);
  }

  .spec-row__cat {
    margin: 0 0 0.3rem;
    font-size: 0.98rem;
    color: var(--color-cyan);
  }

  .spec-row__items {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .cta-strip {
    padding: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    border-left: 4px solid var(--color-electric-blue);
  }

  .cta-strip__title {
    font-size: clamp(1.5rem, 2.8vw, 2.15rem);
  }

  .cta-strip__subtitle {
    margin: 0.4rem 0 0;
    color: var(--text-secondary);
  }

  .cta-strip__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 1024px) {
    .hero__grid,
    .flagship,
    .exp-stack-split {
      grid-template-columns: 1fr;
    }

    .project-line {
      grid-template-columns: 38px 1fr;
    }

    .project-line__desc,
    .project-line__stack {
      grid-column: 2;
    }
  }

  @media (max-width: 640px) {
    .flagship__metrics,
    .indev-grid {
      grid-template-columns: 1fr;
    }

    .trajectory-list {
      padding-left: var(--space-4);
    }

    .cta-strip {
      padding: var(--space-4);
    }
  }
</style>
