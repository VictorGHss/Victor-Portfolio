---
import HeroCommandDeck, { type CommandBlade } from '../components/HeroCommandDeck';
import { EXPERIENCE, SKILL_GROUPS } from '../data/portfolio';
import { PROFILE } from '../data/profile';
import { PROJECTS } from '../data/projects';
import { localizePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const isPt = locale === 'pt-br';
const flagship = PROJECTS[0];
const selectedProjects = PROJECTS.filter(
  (p) => p.slug !== flagship.slug && p.status !== 'in-development' && p.status !== 'concept-planning'
);
const inDevProjects = PROJECTS.filter(
  (p) => p.status === 'in-development' || p.status === 'concept-planning'
);
const primarySkills = SKILL_GROUPS.filter((g) => g.tier === 'primary');
const resumeUrl = PROFILE.resumeFiles[locale];
const flagshipRepoLabel = flagship.repoLabel ? flagship.repoLabel[locale] : t.projects.publicShowcaseLabel;

const heroBlades: CommandBlade[] = [
  {
    code: '01',
    label: 'CTRLS ITSM',
    meta: isPt ? 'PROJETO PRINCIPAL' : 'MAIN PROJECT',
    href: localizePath(locale, `projects/${flagship.slug}`),
  },
  {
    code: '02',
    label: isPt ? 'PROJETOS' : 'PROJECTS',
    meta: isPt ? '7 PROJETOS' : '7 PROJECTS',
    href: localizePath(locale, 'projects'),
  },
  {
    code: '03',
    label: isPt ? 'EXPERIÊNCIA' : 'EXPERIENCE',
    meta: '2024 — 2026',
    href: localizePath(locale, 'experience'),
  },
  {
    code: '04',
    label: isPt ? 'CURRÍCULO' : 'RESUME',
    meta: isPt ? 'PDF · 1 PÁGINA' : '1-PAGE PDF',
    href: resumeUrl,
    download: true,
  },
  {
    code: '05',
    label: isPt ? 'CONTATO' : 'CONTACT',
    meta: isPt ? 'CANAIS DIRETOS' : 'DIRECT LINKS',
    href: localizePath(locale, 'contact'),
  },
];

const tickerItems = [
  'JAVA 21',
  'SPRING BOOT 3',
  'REACT & TYPESCRIPT',
  'IA & AUTOMAÇÕES',
  'POSTGRESQL',
  'REST APIS & WEBHOOKS',
  'REDIS',
  'DOCKER & LINUX',
];
---

<section class="hero section">
  <div class="hero__slash-bg" aria-hidden="true"></div>
  <div class="hero__watermark" aria-hidden="true">VITO // 01</div>

  <div class="container hero__grid">
    <div class="hero__content">
      <span class="display-kicker display-kicker--accent">{t.home.kicker}</span>

      <h1 class="display-title hero__title">
        <span class="hero__line">{t.home.headlineLine1}</span>
        <span class="hero__line">{t.home.headlineLine2}</span>
        <span class="hero__line-shard">
          <span>{t.home.headlineAccent}</span>
        </span>
      </h1>

      <p class="hero__summary">{t.home.summary}</p>

      <div class="hero__actions">
        <a href={localizePath(locale, `projects/${flagship.slug}`)} class="p3-btn p3-btn--primary">
          <span>{t.home.primaryCta}</span>
        </a>
        <a href={resumeUrl} download class="p3-btn p3-btn--secondary">
          <span>{t.home.resumeCta}</span>
        </a>
      </div>
    </div>

    <aside aria-label={t.home.specializationLabel}>
      <HeroCommandDeck
        client:load
        fullName={PROFILE.fullName}
        location={PROFILE.location[locale]}
        education={PROFILE.education[locale]}
        blades={heroBlades}
        githubUrl={PROFILE.githubUrl}
        linkedinUrl={PROFILE.linkedinUrl}
        email={PROFILE.email}
      />
    </aside>
  </div>
</section>

<!-- Kinetic Tilted Ticker Band -->
<div class="p3-ticker" aria-hidden="true">
  <div class="p3-ticker__track">
    {[...tickerItems, ...tickerItems].map((item) => (
      <span class="p3-ticker__item">
        {item} <em>✦</em>
      </span>
    ))}
  </div>
</div>

<section class="section" data-reveal>
  <div class="section-watermark" aria-hidden="true">FEATURED</div>
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">01 // {t.home.featuredTitle}</span>
        <h2 class="display-title section-title">{flagship.name[locale]}</h2>
        <p class="section-subtitle">{t.home.featuredSubtitle}</p>
      </div>
      <a href={localizePath(locale, 'projects')} class="p3-link">
        {t.home.allProjectsCta} →
      </a>
    </div>

    <div class="flagship">
      <div class="flagship__body">
        <div class="flagship__meta">
          <span class="status-label status-label--accent">{t.projects.flagshipBadge}</span>
          <span class="status-label status-label--cyan">{t.projects.statusLabels[flagship.status]}</span>
        </div>

        <p class="flagship__desc">{flagship.solution[locale]}</p>

        <!-- High-Contrast Inverted Paper Slab Metrics -->
        {flagship.metrics && (
          <div class="flagship__metrics paper-slab">
            {flagship.metrics.slice(0, 3).map((metric) => (
              <div class="metric-item">
                <strong class="metric-item__value">{metric.value}</strong>
                <span class="metric-item__label">{metric.label[locale]}</span>
              </div>
            ))}
          </div>
        )}

        <p class="flagship__stack">{flagship.stack.slice(0, 9).join(' · ')}</p>

        <div class="flagship__actions">
          <a href={localizePath(locale, `projects/${flagship.slug}`)} class="p3-btn p3-btn--primary">
            <span>{t.home.viewCaseStudy}</span>
          </a>
          {flagship.repoUrl && (
            <a href={flagship.repoUrl} target="_blank" rel="noopener noreferrer" class="p3-btn p3-btn--secondary">
              <span>{flagshipRepoLabel} ↗</span>
            </a>
          )}
        </div>
      </div>

      {flagship.screenshots && flagship.screenshots[0] && (
        <figure class="flagship__visual">
          <div class="flagship__visual-tag">CASE // 01</div>
          <img
            src={flagship.screenshots[0].src}
            alt={flagship.screenshots[0].alt[locale]}
            loading="lazy"
            width="960"
            height="540"
          />
          <figcaption>{flagship.screenshots[0].caption[locale]}</figcaption>
        </figure>
      )}
    </div>

    <div class="other-projects" data-reveal>
      <h3 class="sub-kicker">{t.home.otherProjectsTitle}</h3>
      <div class="other-projects__list">
        {selectedProjects.map((project) => (
          <a href={localizePath(locale, `projects/${project.slug}`)} class="project-blade">
            <span class="project-blade__num">0{project.priority}</span>
            <div class="project-blade__main">
              <strong class="project-blade__title">{project.name[locale]}</strong>
              <span class="project-blade__desc">{project.tagline[locale]}</span>
            </div>
            <span class="project-blade__stack">{project.stack.slice(0, 4).join(' · ')}</span>
            <span class="project-blade__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>

    <div class="indev-strip" data-reveal>
      <h3 class="sub-kicker sub-kicker--accent">{t.home.inDevTitle}</h3>
      <div class="indev-grid">
        {inDevProjects.map((project) => (
          <a href={localizePath(locale, `projects/${project.slug}`)} class={`indev-card ${project.status === 'concept-planning' ? 'indev-card--concept' : ''}`}>
            <div class="indev-card__top">
              <span class={`status-label ${project.status === 'concept-planning' ? 'status-label--accent' : 'status-label--cyan'}`}>
                {t.projects.statusLabels[project.status]}
              </span>
              <span class="indev-card__num">0{project.priority}</span>
            </div>
            <strong class="indev-card__title">{project.name[locale]}</strong>
            <p class="indev-card__desc">{project.tagline[locale]}</p>
            <span class="indev-card__stack">{project.stack.slice(0, 5).join(' · ')}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section section--compact" data-reveal>
  <div class="section-watermark" aria-hidden="true">TIMELINE</div>
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">02 // {t.nav[2].label} &amp; {t.nav[3].label}</span>
        <h2 class="display-title section-title">{t.home.trajectoryTitle}</h2>
        <p class="section-subtitle">{t.home.trajectorySubtitle}</p>
      </div>
      <div class="section-header__links">
        <a href={localizePath(locale, 'experience')} class="p3-link">
          {t.home.trajectoryCta} →
        </a>
        <a href={localizePath(locale, 'skills')} class="p3-link">
          {t.home.skillsCta} →
        </a>
      </div>
    </div>

    <div class="exp-stack-split">
      <div class="trajectory-list">
        {EXPERIENCE.map((item, idx) => (
          <article class="trajectory-item">
            <span class={`trajectory-node ${idx === 0 ? 'trajectory-node--accent' : ''}`} aria-hidden="true"></span>
            <div class="trajectory-item__period">{item.period[locale]}</div>
            <h3 class="trajectory-item__role heading-title">
              {item.role[locale]} <span class="trajectory-item__company">— {item.company[locale]}</span>
            </h3>
            <p class="trajectory-item__summary">{item.summary[locale]}</p>
          </article>
        ))}
      </div>

      <div class="spec-list surface-block">
        <div class="spec-list__header">ARSENAL // STACK</div>
        {primarySkills.map((group) => (
          <div class="spec-row">
            <h3 class="spec-row__cat">{group.category[locale]}</h3>
            <p class="spec-row__items">{group.items.join(' · ')}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section section--compact" data-reveal>
  <div class="container">
    <div class="cta-poster">
      <div class="cta-poster__content">
        <span class="display-kicker display-kicker--accent">03 // {t.nav[6].label}</span>
        <h2 class="display-title cta-poster__title">{t.home.contactTitle}</h2>
        <p class="cta-poster__subtitle">{t.home.contactSubtitle}</p>
      </div>
      <div class="cta-poster__actions">
        <a href={localizePath(locale, 'contact')} class="p3-btn p3-btn--primary">
          <span>{t.home.contactCta}</span>
        </a>
        <a href={resumeUrl} download class="p3-btn p3-btn--secondary">
          <span>{t.home.resumeCta}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
  }

  .hero__slash-bg {
    position: absolute;
    top: -15%;
    right: -10%;
    width: 52vw;
    height: 130%;
    background: linear-gradient(155deg, rgba(14, 124, 255, 0.22) 0%, rgba(16, 43, 87, 0.36) 60%, transparent 100%);
    clip-path: polygon(26% 0, 100% 0, 74% 100%, 0 100%);
    pointer-events: none;
  }

  .hero__watermark {
    position: absolute;
    bottom: 0.5rem;
    left: -1vw;
    font-family: var(--font-display);
    font-size: clamp(5.5rem, 15vw, 13rem);
    line-height: 0.82;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(60, 226, 255, 0.07);
    transform: skewX(-8deg);
    pointer-events: none;
    user-select: none;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.95fr;
    gap: var(--space-7);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero__title {
    font-size: clamp(2.85rem, 6.2vw, 5.1rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.06em;
  }

  .hero__line {
    transform: skewX(-4deg);
  }

  .hero__line-shard {
    display: inline-block;
    margin-top: 0.14em;
    padding: 0.14em 0.36em 0.12em 0.28em;
    line-height: 1.08;
    background: var(--color-pure-white);
    color: var(--text-inverse);
    transform: skewX(-7deg);
    box-shadow: 7px 7px 0px var(--color-accent);
  }

  .hero__line-shard > span {
    display: inline-block;
    transform: skewX(3deg);
  }

  .hero__summary {
    margin: var(--space-5) 0 var(--space-5);
    color: var(--text-secondary);
    font-size: 1.08rem;
    max-width: 55ch;
    border-left: 3px solid var(--color-electric-blue);
    padding-left: 1rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Tilted P3R × P5R Marquee Ribbon */
  .p3-ticker {
    position: relative;
    z-index: 3;
    background: var(--color-electric-blue);
    border-top: 2px solid var(--color-pure-white);
    border-bottom: 3px solid var(--color-accent);
    padding-block: 0.68rem;
    transform: rotate(-1.3deg) scale(1.03);
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(2, 6, 13, 0.65);
  }

  .p3-ticker__track {
    display: flex;
    width: max-content;
    gap: 2rem;
    animation: tickerSlide 28s linear infinite;
  }

  .p3-ticker__item {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    color: var(--color-pure-white);
    white-space: nowrap;
  }

  .p3-ticker__item em {
    font-style: normal;
    color: var(--color-cyan);
    margin-left: 1.5rem;
  }

  @keyframes tickerSlide {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Flagship Showcase */
  .flagship {
    display: grid;
    grid-template-columns: 1.12fr 1fr;
    gap: var(--space-6);
    align-items: start;
    margin-bottom: var(--space-7);
  }

  .flagship__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: var(--space-4);
  }

  .flagship__desc {
    margin: 0 0 var(--space-5);
    color: var(--text-secondary);
    font-size: 1.04rem;
  }

  .flagship__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    padding: 1.25rem 1.35rem;
  }

  .metric-item {
    border-left: 3px solid var(--color-electric-blue);
    padding-left: 0.75rem;
  }

  .metric-item:first-child {
    border-left-color: var(--color-accent);
  }

  .metric-item__value {
    display: block;
    font-family: var(--font-display);
    font-size: 2.15rem;
    color: var(--text-inverse);
    line-height: 1;
    margin-bottom: 0.2rem;
  }

  .metric-item__label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: #263b59;
    line-height: 1.35;
  }

  .flagship__stack {
    margin: 0 0 var(--space-5);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-cyan);
  }

  .flagship__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .flagship__visual {
    position: relative;
    margin: 0;
    padding: 1rem;
    background: #08152b;
    border: 2px solid var(--color-cyan);
    box-shadow: 9px 9px 0px var(--color-electric-blue);
    transition: transform var(--duration-fast) var(--ease-pop), box-shadow var(--duration-fast) var(--ease-pop);
  }

  .flagship__visual:hover {
    transform: translate(-3px, -3px);
    box-shadow: 12px 12px 0px var(--color-accent);
  }

  .flagship__visual-tag {
    position: absolute;
    top: -12px;
    right: 16px;
    background: var(--color-accent);
    color: var(--color-pure-white);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.18rem 0.65rem;
    transform: skewX(-10deg);
  }

  .flagship__visual img {
    width: 100%;
    height: auto;
  }

  .flagship__visual figcaption {
    padding-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .sub-kicker {
    display: inline-block;
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-pure-white);
    border-left: 4px solid var(--color-cyan);
    padding-left: 0.75rem;
  }

  .sub-kicker--accent {
    border-left-color: var(--color-accent);
  }

  /* Interactive Project Blades */
  .other-projects {
    margin-bottom: var(--space-7);
  }

  .other-projects__list {
    display: grid;
    gap: 0.65rem;
  }

  .project-blade {
    display: grid;
    grid-template-columns: 56px 1.2fr 0.8fr 32px;
    gap: var(--space-4);
    align-items: center;
    padding: 1.15rem 1.35rem;
    background: var(--surface-elevated);
    border-left: 4px solid var(--color-electric-blue);
    border-top: 1px solid rgba(60, 226, 255, 0.16);
    border-right: 1px solid rgba(60, 226, 255, 0.16);
    border-bottom: 1px solid rgba(60, 226, 255, 0.16);
    transition:
      transform var(--duration-fast) var(--ease-pop),
      background-color var(--duration-fast) var(--ease-snappy),
      border-color var(--duration-fast) var(--ease-snappy),
      box-shadow var(--duration-fast) var(--ease-pop);
  }

  .project-blade:hover {
    background: #0d2244;
    border-left-color: var(--color-accent);
    transform: translateX(8px);
    box-shadow: -6px 6px 0px var(--color-cyan);
  }

  .project-blade__num {
    font-family: var(--font-display);
    font-size: 1.9rem;
    color: var(--color-cyan);
    line-height: 1;
    transform: skewX(-8deg);
  }

  .project-blade:hover .project-blade__num {
    color: var(--color-pure-white);
  }

  .project-blade__main {
    display: grid;
    gap: 0.2rem;
  }

  .project-blade__title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-pure-white);
  }

  .project-blade__desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .project-blade__stack {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    text-align: right;
  }

  .project-blade__arrow {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-cyan);
    text-align: right;
    transition: transform var(--duration-fast) var(--ease-pop), color var(--duration-fast);
  }

  .project-blade:hover .project-blade__arrow {
    transform: translateX(4px);
    color: var(--color-accent);
  }

  .indev-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .indev-card--concept {
    border-left-color: var(--color-accent);
  }

  .indev-card {
    padding: var(--space-5);
    background: #08162c;
    border: 1px solid rgba(60, 226, 255, 0.26);
    border-left: 4px solid var(--color-cyan);
    box-shadow: 6px 6px 0px rgba(14, 124, 255, 0.65);
    display: grid;
    gap: 0.55rem;
    transition: transform var(--duration-fast) var(--ease-pop), box-shadow var(--duration-fast) var(--ease-pop);
  }

  .indev-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0px var(--color-cyan);
  }

  .indev-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .indev-card__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: rgba(60, 226, 255, 0.55);
  }

  .indev-card__title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-pure-white);
  }

  .indev-card__desc {
    margin: 0;
    font-size: 0.94rem;
    color: var(--text-secondary);
  }

  .indev-card__stack {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-cyan);
    padding-top: 0.35rem;
  }

  .section-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .exp-stack-split {
    display: grid;
    grid-template-columns: 1.12fr 0.95fr;
    gap: var(--space-6);
    align-items: start;
  }

  .trajectory-list {
    display: grid;
    gap: var(--space-6);
    border-left: 3px solid var(--color-electric-blue);
    padding-left: var(--space-5);
  }

  .trajectory-item {
    position: relative;
  }

  .trajectory-node {
    position: absolute;
    left: calc(-1 * var(--space-5) - 8px);
    top: 4px;
    width: 13px;
    height: 13px;
    background: var(--color-cyan);
    transform: rotate(45deg);
    border: 2px solid var(--surface-bg);
  }

  .trajectory-node--accent {
    background: var(--color-accent);
  }

  .trajectory-item__period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-cyan);
    margin-bottom: 0.3rem;
  }

  .trajectory-item__role {
    margin: 0 0 0.45rem;
    font-size: 1.2rem;
  }

  .trajectory-item__company {
    color: var(--text-muted);
    font-weight: 500;
  }

  .trajectory-item__summary {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.96rem;
  }

  .spec-list {
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  .spec-list__header {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
