---
import ScreenshotGallery from '../components/ScreenshotGallery';
import { localizePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = UI[locale];
const statusLabel = t.projects.statusLabels[project.status];
const repoButtonLabel = project.repoLabel ? project.repoLabel[locale] : 'GitHub';
---

<section class="section">
  <div class="section-watermark" aria-hidden="true">0{project.priority} // CASE</div>
  <div class="container">
    <a href={localizePath(locale, 'projects')} class="p3-link back-link">
      ← {t.projects.backToProjects}
    </a>

    <header class="case-header surface-block">
      <div class="case-header__badges">
        <span class={`status-label ${project.status === 'concluded-operation' || project.status === 'collaborative' ? 'status-label--cyan' : ''}`}>
          {statusLabel}
        </span>
        {project.priority === 1 && (
          <span class="status-label status-label--accent">{t.projects.flagshipBadge}</span>
        )}
      </div>

      <h1 class="display-title case-header__title">{project.name[locale]}</h1>
      <p class="case-header__tagline">{project.tagline[locale]}</p>
      <p class="case-header__timeline">{project.timelineContext[locale]}</p>

      <div class="case-header__actions">
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="p3-btn p3-btn--primary">
            <span>{project.liveLabel ? project.liveLabel[locale] : 'Live'} ↗</span>
          </a>
        )}
        {project.repoUrl && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={`p3-btn ${project.liveUrl ? 'p3-btn--secondary' : 'p3-btn--primary'}`}
          >
            <span>{repoButtonLabel} ↗</span>
          </a>
        )}
        {project.isPrivateCore && (
          <span class="case-header__private-note">{t.projects.privateNoteLabel}</span>
        )}
      </div>
    </header>

    {project.metrics && (
      <div class="case-metrics paper-slab" data-reveal>
        {project.metrics.map((metric) => (
          <div class="case-metric">
            <strong class="case-metric__value">{metric.value}</strong>
            <span class="case-metric__label">{metric.label[locale]}</span>
          </div>
        ))}
      </div>
    )}

    <div class="case-grid">
      <div class="case-main">
        <article class="case-block" data-reveal>
          <h2 class="display-title case-block__title">{t.projects.problemLabel}</h2>
          <p>{project.problem[locale]}</p>
        </article>

        <article class="case-block" data-reveal>
          <h2 class="display-title case-block__title">{t.projects.solutionLabel}</h2>
          <p>{project.solution[locale]}</p>
        </article>

        <article class="case-block" data-reveal>
          <h2 class="display-title case-block__title">{t.projects.roleLabel}</h2>
          <p>{project.role[locale]}</p>
        </article>

        {project.roadmap && (
          <article class="case-block" data-reveal>
            <h2 class="display-title case-block__title">{t.projects.roadmapLabel}</h2>
            <div class="roadmap-groups">
              <div>
                <h3 class="roadmap-sub roadmap-sub--done">{t.projects.implementedLabel}</h3>
                <ul class="case-list">
                  {project.roadmap.implemented[locale].map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="roadmap-sub roadmap-sub--wip">{t.projects.inProgressLabel}</h3>
                <ul class="case-list">
                  {project.roadmap.inProgress[locale].map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="roadmap-sub roadmap-sub--plan">{t.projects.plannedLabel}</h3>
                <ul class="case-list">
                  {project.roadmap.planned[locale].map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        )}

        {project.architecture && (
          <article class="case-block" data-reveal>
            <h2 class="display-title case-block__title">{t.projects.architectureLabel}</h2>
            <ul class="case-list">
              {project.architecture[locale].map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        )}

        {project.challenges && (
          <article class="case-block" data-reveal>
            <h2 class="display-title case-block__title">
              {locale === 'pt-br' ? 'Desafios na prática' : 'Tricky parts I solved'}
            </h2>
            <ul class="case-list">
              {project.challenges[locale].map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        )}
      </div>

      <aside class="case-aside surface-block" data-reveal>
        <div class="case-aside__section">
          <h2 class="display-title case-block__title">{t.projects.stackLabel}</h2>
          <p class="case-stack-text">{project.stack.join(' · ')}</p>
        </div>

        <div class="case-aside__section">
          <h2 class="display-title case-block__title">{t.projects.featuresLabel}</h2>
          <ul class="case-list">
            {project.features[locale].map((feat) => (
              <li>{feat}</li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    {project.screenshots && project.screenshots.length > 0 && (
      <section class="case-gallery" data-reveal>
        <h2 class="display-title section-title">{t.projects.screenshotsLabel}</h2>
        <ScreenshotGallery
          client:load
          screenshots={project.screenshots}
          locale={locale}
          zoomHint={t.projects.zoomHint}
          closeLabel={t.projects.closeLightbox}
        />
      </section>
    )}
  </div>
</section>

<style>
  .back-link {
    margin-bottom: var(--space-4);
  }

  .case-header {
    padding: var(--space-6);
    margin-bottom: var(--space-6);
    border-left: 5px solid var(--color-accent);
    box-shadow: 8px 8px 0px var(--color-electric-blue);
  }

  .case-header__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: var(--space-3);
  }

  .case-header__title {
    font-size: clamp(2.5rem, 5.5vw, 4.2rem);
    transform: skewX(-3deg);
    transform-origin: left bottom;
  }

  .case-header__tagline {
    margin: 0.75rem 0 0.45rem;
    font-size: 1.12rem;
    color: var(--text-secondary);
    max-width: 68ch;
  }

  .case-header__timeline {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-cyan);
  }

  .case-header__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .case-header__private-note {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .case-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin-bottom: var(--space-6);
    padding: 1.4rem 1.5rem;
  }

  .case-metric {
    border-left: 3px solid var(--color-electric-blue);
    padding-left: 0.85rem;
  }

  .case-metric:first-child {
    border-left-color: var(--color-accent);
  }

  .case-metric__value {
    display: block;
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--text-inverse);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .case-metric__label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #263b59;
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: var(--space-6);
    align-items: start;
  }

  .case-main {
    display: grid;
    gap: var(--space-5);
  }

  .case-block {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(60, 226, 255, 0.15);
  }

  .case-block__title {
    font-size: 1.7rem;
    color: var(--color-cyan);
    margin-bottom: var(--space-3);
  }

  .case-block p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.02rem;
  }

  .roadmap-groups {
    display: grid;
    gap: var(--space-4);
  }

  .roadmap-sub {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .roadmap-sub--done { color: var(--color-cyan); }
  .roadmap-sub--wip { color: var(--color-accent); }
  .roadmap-sub--plan { color: var(--text-muted); }

  .case-aside {
    padding: var(--space-5);
    display: grid;
    gap: var(--space-5);
    border-left: 4px solid var(--color-cyan);
  }

  .case-stack-text {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .case-list {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--text-secondary);
    display: grid;
    gap: 0.55rem;
  }

  .case-gallery {
    margin-top: var(--space-7);
  }

  @media (max-width: 1024px) {
    .case-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .case-metrics {
      grid-template-columns: 1fr;
    }

    .case-header {
      padding: var(--space-4);
    }
  }
</style>
