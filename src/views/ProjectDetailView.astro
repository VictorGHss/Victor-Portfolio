---
import { localizePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = UI[locale];
const statusLabel = t.projects.statusLabels[project.status];
---

<section class="section">
  <div class="container">
    <a href={localizePath(locale, 'projects')} class="p3-link back-link">
      ← {t.projects.backToProjects}
    </a>

    <header class="case-header surface-block">
      <div class="case-header__badges">
        <span class={`status-label ${project.status === 'concluded-operation' || project.status === 'collaborative-in-use' ? 'status-label--cyan' : ''}`}>
          {statusLabel}
        </span>
        {project.priority === 1 && (
          <span class="status-label status-label--accent">{t.projects.flagshipBadge}</span>
        )}
        {project.secondary && (
          <span class="status-label">{t.projects.secondaryBadge}</span>
        )}
      </div>

      <h1 class="display-title case-header__title">{project.name[locale]}</h1>
      <p class="case-header__tagline">{project.tagline[locale]}</p>
      <p class="case-header__timeline">{project.timelineContext[locale]}</p>

      <div class="case-header__actions">
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="p3-btn p3-btn--primary">
            {project.liveLabel ? project.liveLabel[locale] : 'Live'} ↗
          </a>
        )}
        {project.repoUrl && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={`p3-btn ${project.liveUrl ? 'p3-btn--secondary' : 'p3-btn--primary'}`}
          >
            {t.projects.publicRepoLabel} ↗
          </a>
        )}
        {project.isPrivateCore && (
          <span class="case-header__private-note">{t.projects.privateNoteLabel}</span>
        )}
      </div>
    </header>

    {project.metrics && (
      <div class="case-metrics">
        {project.metrics.map((metric) => (
          <div class="case-metric">
            <strong class="case-metric__value">{metric.value}</strong>
            <span class="case-metric__label">{metric.label[locale]}</span>
          </div>
        ))}
      </div>
    )}

    <div class="case-grid">
      <div class="case-main">
        <article class="case-block">
          <h2 class="display-title case-block__title">{t.projects.problemLabel}</h2>
          <p>{project.problem[locale]}</p>
        </article>

        <article class="case-block">
          <h2 class="display-title case-block__title">{t.projects.solutionLabel}</h2>
          <p>{project.solution[locale]}</p>
        </article>

        <article class="case-block">
          <h2 class="display-title case-block__title">{t.projects.roleLabel}</h2>
          <p>{project.role[locale]}</p>
        </article>

        {project.architecture && (
          <article class="case-block">
            <h2 class="display-title case-block__title">{t.projects.architectureLabel}</h2>
            <ul class="case-list">
              {project.architecture[locale].map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        )}

        {project.challenges && (
          <article class="case-block">
            <h2 class="display-title case-block__title">
              {locale === 'pt-br' ? 'Desafios de Engenharia' : 'Engineering Challenges'}
            </h2>
            <ul class="case-list">
              {project.challenges[locale].map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        )}
      </div>

      <aside class="case-aside surface-block">
        <div class="case-aside__section">
          <h2 class="display-title case-block__title">{t.projects.stackLabel}</h2>
          <p class="case-stack-text">{project.stack.join(' · ')}</p>
        </div>

        <div class="case-aside__section">
          <h2 class="display-title case-block__title">{t.projects.featuresLabel}</h2>
          <ul class="case-list">
            {project.features[locale].map((feat) => (
              <li>{feat}</li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    {project.screenshots && project.screenshots.length > 0 && (
      <section class="case-gallery">
        <h2 class="display-title section-title">{t.projects.screenshotsLabel}</h2>
        <div class={`case-gallery__grid ${project.screenshots.length === 1 ? 'case-gallery__grid--single' : ''}`}>
          {project.screenshots.map((shot) => (
            <figure class={`case-shot surface-block ${shot.compact ? 'case-shot--compact' : ''}`}>
              <img src={shot.src} alt={shot.alt[locale]} loading="lazy" width="960" height="540" />
              <figcaption>{shot.caption[locale]}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </div>
</section>

<style>
  .back-link {
    margin-bottom: var(--space-4);
  }

  .case-header {
    padding: var(--space-6);
    margin-bottom: var(--space-6);
    border-left: 4px solid var(--color-electric-blue);
  }

  .case-header__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: var(--space-3);
  }

  .case-header__title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
  }

  .case-header__tagline {
    margin: 0.6rem 0 0.4rem;
    font-size: 1.08rem;
    color: var(--text-secondary);
    max-width: 68ch;
  }

  .case-header__timeline {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-cyan);
  }

  .case-header__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .case-header__private-note {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .case-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin-bottom: var(--space-6);
    padding-block: var(--space-4);
    border-top: 1px solid rgba(232, 242, 255, 0.09);
    border-bottom: 1px solid rgba(232, 242, 255, 0.09);
  }

  .case-metric__value {
    display: block;
    font-family: var(--font-display);
    font-size: 1.85rem;
    color: var(--color-cyan);
  }

  .case-metric__label {
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: var(--space-6);
    align-items: start;
  }

  .case-main {
    display: grid;
    gap: var(--space-5);
  }

  .case-block {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(232, 242, 255, 0.08);
  }

  .case-block__title {
    font-size: 1.35rem;
    color: var(--color-cyan);
    margin-bottom: var(--space-3);
  }

  .case-block p {
    margin: 0;
    color: var(--text-secondary);
  }

  .case-aside {
    padding: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }

  .case-stack-text {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .case-list {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--text-secondary);
    display: grid;
    gap: 0.55rem;
  }

  .case-gallery {
    margin-top: var(--space-7);
  }

  .case-gallery__grid {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .case-gallery__grid--single {
    grid-template-columns: 1fr;
  }

  .case-shot {
    margin: 0;
    padding: var(--space-3);
  }

  .case-shot--compact {
    max-width: 540px;
  }

  .case-shot img {
    width: 100%;
    height: auto;
  }

  .case-shot figcaption {
    margin-top: 0.65rem;
    font-size: 0.86rem;
    color: var(--text-secondary);
  }

  @media (max-width: 1024px) {
    .case-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-grid,
    .case-gallery__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .case-metrics {
      grid-template-columns: 1fr;
    }

    .case-header {
      padding: var(--space-4);
    }
  }
</style>
