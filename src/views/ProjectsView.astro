---
import ProjectCard from '../components/ProjectCard.astro';
import { PROJECTS } from '../data/projects';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const sorted = [...PROJECTS].sort((a, b) => a.priority - b.priority);
---

<section class="section">
  <div class="section-watermark" aria-hidden="true">PROJECTS</div>
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">02 // {t.nav[1].label}</span>
        <h1 class="display-title section-title">{t.projects.pageTitle}</h1>
        <p class="section-subtitle">{t.projects.pageSubtitle}</p>
      </div>
    </div>

    <div class="projects-intro paper-slab">
      <span class="projects-intro__tag">DEV // NOTE</span>
      <p>{t.projects.introNote}</p>
    </div>

    <div class="projects-stack">
      {sorted.map((project) => (
        <ProjectCard project={project} locale={locale} />
      ))}
    </div>
  </div>
</section>

<style>
  .projects-intro {
    margin: 0 0 var(--space-6);
    padding: 1.15rem 1.45rem;
    max-width: 78ch;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1rem;
  }

  .projects-intro__tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--color-accent);
    color: var(--color-pure-white);
    padding: 0.16rem 0.55rem;
    transform: skewX(-8deg);
  }

  .projects-intro p {
    margin: 0;
    color: var(--text-inverse);
    font-weight: 500;
    font-size: 1rem;
    flex: 1 1 420px;
  }

  .projects-stack {
    display: grid;
    gap: var(--space-5);
  }
</style>
