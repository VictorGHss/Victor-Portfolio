---
import ProjectCard from '../components/ProjectCard.astro';
import { PROJECTS } from '../data/projects';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const sorted = [...PROJECTS].sort((a, b) => a.priority - b.priority);
---

<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">02 // {t.nav[1].label}</span>
        <h1 class="display-title section-title">{t.projects.pageTitle}</h1>
        <p class="section-subtitle">{t.projects.pageSubtitle}</p>
      </div>
    </div>

    <p class="projects-intro">{t.projects.introNote}</p>

    <div class="projects-stack">
      {sorted.map((project) => (
        <ProjectCard project={project} locale={locale} />
      ))}
    </div>
  </div>
</section>

<style>
  .projects-intro {
    margin: 0 0 var(--space-5);
    color: var(--text-secondary);
    max-width: 70ch;
    font-size: 1.02rem;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-cyan);
  }

  .projects-stack {
    display: grid;
    gap: var(--space-4);
  }
</style>
