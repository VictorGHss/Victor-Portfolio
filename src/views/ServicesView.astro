---
import { SERVICES } from '../data/portfolio';
import { localizePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
---

<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">06 // {t.nav[5].label}</span>
        <h1 class="display-title section-title">{t.services.pageTitle}</h1>
        <p class="section-subtitle">{t.services.pageSubtitle}</p>
      </div>
    </div>

    <div class="services-list">
      {SERVICES.map((service, idx) => (
        <article class="service-row">
          <div class="service-row__num">0{idx + 1}</div>
          <div>
            <h2 class="display-title service-row__title">{service.title[locale]}</h2>
            <p class="service-row__summary">{service.summary[locale]}</p>
          </div>
          <ul class="service-row__list">
            {service.deliverables[locale].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="services-footer surface-block">
      <p>{t.services.scopeNote}</p>
      <a href={localizePath(locale, 'contact')} class="p3-btn p3-btn--primary">
        {t.services.ctaLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .services-list {
    border-top: 1px solid rgba(232, 242, 255, 0.09);
    margin-bottom: var(--space-6);
  }

  .service-row {
    display: grid;
    grid-template-columns: 48px 1.2fr 0.9fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid rgba(232, 242, 255, 0.08);
    align-items: start;
  }

  .service-row__num {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-cyan);
    padding-top: 0.25rem;
  }

  .service-row__title {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }

  .service-row__summary {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .service-row__list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    display: grid;
    gap: 0.35rem;
  }

  .services-footer {
    padding: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-left: 3px solid var(--color-electric-blue);
  }

  .services-footer p {
    margin: 0;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  @media (max-width: 820px) {
    .service-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
