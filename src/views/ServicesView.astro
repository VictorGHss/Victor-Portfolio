---
import { SERVICES } from '../data/portfolio';
import { localizePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
---

<section class="section">
  <div class="section-watermark" aria-hidden="true">SERVICES</div>
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">06 // {t.nav[5].label}</span>
        <h1 class="display-title section-title">{t.services.pageTitle}</h1>
        <p class="section-subtitle">{t.services.pageSubtitle}</p>
      </div>
    </div>

    <div class="services-list">
      {SERVICES.map((service, idx) => (
        <article class="service-row surface-block" data-reveal>
          <div class="service-row__num">0{idx + 1}</div>
          <div>
            <h2 class="display-title service-row__title">{service.title[locale]}</h2>
            <p class="service-row__summary">{service.summary[locale]}</p>
            <p class="service-row__proof">{service.proof[locale]}</p>
          </div>
          <ul class="service-row__list">
            {service.deliverables[locale].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="services-footer paper-slab" data-reveal>
      <p>{t.services.scopeNote}</p>
      <a href={localizePath(locale, 'contact')} class="p3-btn p3-btn--secondary">
        <span>{t.services.ctaLabel}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .services-list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .service-row {
    display: grid;
    grid-template-columns: 64px 1.25fr 0.85fr;
    gap: var(--space-5);
    padding: var(--space-5);
    border-left: 5px solid var(--color-electric-blue);
    align-items: start;
    transition: transform var(--duration-fast) var(--ease-pop), border-color var(--duration-fast);
  }

  .service-row:hover {
    border-left-color: var(--color-accent);
    transform: translateX(6px);
  }

  .service-row__num {
    font-family: var(--font-display);
    font-size: 2.3rem;
    line-height: 0.92;
    color: var(--color-cyan);
    transform: skewX(-8deg);
  }

  .service-row__title {
    font-size: 1.75rem;
    margin-bottom: 0.45rem;
  }

  .service-row__summary {
    margin: 0 0 0.55rem;
    color: var(--text-secondary);
    font-size: 0.98rem;
  }

  .service-row__proof {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-cyan);
  }

  .service-row__list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    display: grid;
    gap: 0.4rem;
  }

  .services-footer {
    padding: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .services-footer p {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.12rem;
    color: var(--text-inverse);
    max-width: 58ch;
  }

  @media (max-width: 820px) {
    .service-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
