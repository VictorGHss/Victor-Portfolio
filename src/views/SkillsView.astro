---
import { SKILL_GROUPS } from '../data/portfolio';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const primaryGroups = SKILL_GROUPS.filter((g) => g.tier === 'primary');
const secondaryGroups = SKILL_GROUPS.filter((g) => g.tier === 'secondary');
---

<section class="section">
  <div class="section-watermark" aria-hidden="true">ARSENAL</div>
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">04 // {t.nav[3].label}</span>
        <h1 class="display-title section-title">{t.skills.pageTitle}</h1>
        <p class="section-subtitle">{t.skills.pageSubtitle}</p>
      </div>
    </div>

    <h2 class="tier-heading">{t.skills.primaryTier}</h2>
    <div class="skills-grid">
      {primaryGroups.map((group, idx) => (
        <article class="skill-slab surface-block" data-reveal>
          <div class="skill-slab__head">
            <span class="skill-slab__num">0{idx + 1}</span>
            <h3 class="display-title skill-slab__title">{group.category[locale]}</h3>
          </div>
          <ul class="skill-slab__list">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <h2 class="tier-heading tier-heading--secondary">{t.skills.secondaryTier}</h2>
    <div class="skills-secondary">
      {secondaryGroups.map((group) => (
        <article class="skill-slab skill-slab--wide surface-block" data-reveal>
          <div class="skill-slab__head">
            <span class="skill-slab__num">+</span>
            <h3 class="display-title skill-slab__title">{group.category[locale]}</h3>
          </div>
          <ul class="skill-slab__list skill-slab__list--inline">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .tier-heading {
    display: inline-block;
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--color-pure-white);
    color: var(--text-inverse);
    padding: 0.22rem 0.75rem;
    transform: skewX(-8deg);
  }

  .tier-heading--secondary {
    margin-top: var(--space-7);
    background: var(--color-accent);
    color: var(--color-pure-white);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .skill-slab {
    padding: var(--space-5);
    border-left: 4px solid var(--color-cyan);
    transition: transform var(--duration-fast) var(--ease-pop), box-shadow var(--duration-fast) var(--ease-pop);
  }

  .skill-slab:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0px var(--color-electric-blue);
  }

  .skill-slab__head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: var(--space-4);
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(60, 226, 255, 0.18);
  }

  .skill-slab__num {
    font-family: var(--font-display);
    font-size: 1.95rem;
    color: var(--color-accent);
    line-height: 1;
    transform: skewX(-8deg);
  }

  .skill-slab__title {
    font-size: 1.65rem;
  }

  .skill-slab__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .skill-slab__list li::before {
    content: '▸ ';
    color: var(--color-cyan);
  }

  .skill-slab__list--inline {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 820px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .skill-slab__list--inline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .skill-slab__list,
    .skill-slab__list--inline {
      grid-template-columns: 1fr;
    }
  }
</style>
