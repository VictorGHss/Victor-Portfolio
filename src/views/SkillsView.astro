---
import { SKILL_GROUPS } from '../data/portfolio';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const primaryGroups = SKILL_GROUPS.filter((g) => g.tier === 'primary');
const secondaryGroups = SKILL_GROUPS.filter((g) => g.tier === 'secondary');
---

<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="display-kicker">04 // {t.nav[3].label}</span>
        <h1 class="display-title section-title">{t.skills.pageTitle}</h1>
        <p class="section-subtitle">{t.skills.pageSubtitle}</p>
      </div>
    </div>

    <h2 class="tier-heading">{t.skills.primaryTier}</h2>
    <div class="skills-table">
      {primaryGroups.map((group, idx) => (
        <article class="skill-row">
          <div class="skill-row__label">
            <span class="skill-row__num">0{idx + 1}</span>
            <h3 class="display-title skill-row__title">{group.category[locale]}</h3>
          </div>
          <ul class="skill-row__list">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <h2 class="tier-heading tier-heading--secondary">{t.skills.secondaryTier}</h2>
    <div class="skills-table">
      {secondaryGroups.map((group) => (
        <article class="skill-row">
          <div class="skill-row__label">
            <span class="skill-row__num">+</span>
            <h3 class="display-title skill-row__title">{group.category[locale]}</h3>
          </div>
          <ul class="skill-row__list">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .tier-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-cyan);
  }

  .tier-heading--secondary {
    margin-top: var(--space-7);
    color: var(--text-muted);
  }

  .skills-table {
    border-top: 1px solid rgba(232, 242, 255, 0.09);
  }

  .skill-row {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid rgba(232, 242, 255, 0.08);
    align-items: start;
  }

  .skill-row__label {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .skill-row__num {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-cyan);
  }

  .skill-row__title {
    font-size: 1.35rem;
  }

  .skill-row__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    color: var(--text-secondary);
  }

  @media (max-width: 820px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .skill-row__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .skill-row__list {
      grid-template-columns: 1fr;
    }
  }
</style>
